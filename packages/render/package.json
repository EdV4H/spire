{
	"name": "@edv4h/spire-render",
	"version": "0.1.0",
	"type": "module",
	"description": "Spire renderer contracts and default theme (v0.1: types only)",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@edv4h/spire-core": "workspace:*",
		"@edv4h/spire-layout": "workspace:*"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdV4H/spire.git",
		"directory": "packages/render"
	},
	"homepage": "https://github.com/EdV4H/spire#readme",
	"bugs": {
		"url": "https://github.com/EdV4H/spire/issues"
	}
}
